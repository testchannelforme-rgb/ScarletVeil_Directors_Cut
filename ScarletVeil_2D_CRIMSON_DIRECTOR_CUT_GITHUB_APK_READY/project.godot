; Scarlet Veil — 2D Dark-Fantasy Metroidvania vertical slice
config_version=5

[application]
config/name="Scarlet Veil"
config/description="A cinematic 2D dark-fantasy metroidvania about memory, identity and the cost of forgetting."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon.png"

[autoload]
SaveManager="*res://scripts/save_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
GameFX="*res://scripts/game_fx.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.008, 0.004, 0.012, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
default_bus_layout="res://default_bus_layout.tres"
